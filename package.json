{
  "name": "merge-discovery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "tsx scripts/validate-content.ts",
    "simulate:content": "tsx scripts/simulate-content.ts",
    "audit:proposal:8a": "tsx scripts/audit-phase8a-proposal.ts",
    "build": "npm run validate:content && npm run simulate:content && tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:e2e": "playwright test",
    "profile:catalog": "tsx scripts/profile-catalog.ts",
    "profile:map": "tsx scripts/profile-map.ts",
    "validate:pwa": "tsx scripts/validate-pwa.ts",
    "measure:bundle": "tsx scripts/measure-bundle.ts",
    "test:production": "playwright test --config playwright.production.config.ts"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.1.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^5.0.3"
  }
}
